# Base URL of a real, reachable Dispatcharr instance to develop against.
# Vite's dev server proxies /api requests here so the app can always call
# relative /api/... URLs, matching how it's served in production (same-origin
# overlay). Copy this file to .env.local (already git-ignored) and fill in
# your own instance — never commit .env.local.
DISPATCHARR_DEV_PROXY_TARGET=https://your-dispatcharr-instance.example.com
